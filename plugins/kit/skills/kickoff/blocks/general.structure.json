{
  "block": "general",
  "version": 1,
  "appliesTo": { "kind": "*" },
  "checks": [
    {
      "rule": "G9",
      "type": "forbidden-path",
      "description": "No env file with real values is tracked",
      "files": ["**/.env", "**/.env.*"],
      "exclude": ["**/*.example", "**/.env.sample", "**/.env.template"],
      "severity": "BLOCKER",
      "fix": "git rm --cached the file, add it to .gitignore, rotate every value it held"
    },
    {
      "rule": "G9",
      "type": "forbidden-content",
      "description": "No provider key or private key in any file",
      "files": ["**"],
      "pattern": "(sk_live_[0-9a-zA-Z]{10,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)",
      "severity": "BLOCKER",
      "fix": "remove it, rotate the key at the provider, read it from the env schema"
    },
    {
      "rule": "G9",
      "type": "forbidden-content",
      "description": "No secret literal assigned in source",
      "files": ["**/*.{ts,tsx,js,jsx,mjs,cjs,astro,py,json,yml,yaml,toml}"],
      "exclude": ["**/__tests__/**", "**/*.{test,spec}.*", "**/*.int-spec.*", "**/test/**", "**/tests/**", "**/fixtures/**", "**/e2e/**", "**/*.example", "**/*.structure.json", "**/package.json"],
      "pattern": "(api[_-]?key|secret|passw(or)?d|token|private[_-]?key)[\"']?\\s*[:=]\\s*[\"'][^\"'\\s]{12,}[\"']",
      "flags": "i",
      "except": "(<[^>]+>|your[-_ ]|example|changeme|placeholder|xxxx|\\$\\{|process\\.env|import\\.meta\\.env|os\\.environ|getenv)",
      "severity": "HIGH",
      "fix": "move the value to the env schema and .env.example (placeholder); rotate it if it was real"
    },
    {
      "rule": "G17",
      "type": "forbidden-content",
      "description": "No raw bidi controls, zero-width spaces or direction marks",
      "files": ["**"],
      "pattern": "[\\u202A-\\u202E\\u2066-\\u2069\\u200B\\u200E\\u200F]",
      "severity": "HIGH",
      "fix": "delete the character; build it with String.fromCodePoint when code needs it"
    },
    {
      "rule": "G4",
      "type": "forbidden-content",
      "description": "No commented-out code",
      "files": ["**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "pattern": "^\\s*//\\s*(const|let|var|if|for|while|return|await|export|import|function|class|switch|try)\\b.*(;|\\{|=>)\\s*$",
      "severity": "HIGH",
      "fix": "delete it; git history keeps the old code"
    },
    {
      "rule": "G4",
      "type": "forbidden-content",
      "description": "No commented-out code",
      "files": ["**/*.py"],
      "pattern": "^\\s*#\\s*(def|class|return|import|from|if|for|while)\\b.*[:)]\\s*$",
      "severity": "HIGH",
      "fix": "delete it; git history keeps the old code"
    },
    {
      "rule": "G4",
      "type": "forbidden-content",
      "description": "No TODO/FIXME left in code",
      "files": ["**/*.{ts,tsx,js,jsx,mjs,cjs,astro,py}"],
      "pattern": "\\b(TODO|FIXME|XXX|HACK)\\b",
      "severity": "MEDIUM",
      "fix": "do it now, or move it to the tracking doc with an ID and delete the comment"
    },
    {
      "rule": "G4",
      "type": "unused-exports",
      "description": "Named export with no importer (candidate dead code)",
      "files": ["**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "exclude": ["**/__tests__/**", "**/*.{test,spec}.*", "**/*.int-spec.*", "**/*.d.ts", "**/*.config.*", "**/e2e/**", "**/scripts/**"],
      "ignoreNames": "getStaticPaths|prerender|partial|ErrorBoundary|unstable_settings|generateMetadata|generateStaticParams|metadata|viewport|config|GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|ALL|loader|action|meta|links|headers|handler|onRequest|setup|teardown|globalSetup",
      "severity": "MEDIUM",
      "fix": "delete the export (or the code) if nothing uses it; if a framework or another repo consumes it, say so in a comment"
    }
  ]
}
