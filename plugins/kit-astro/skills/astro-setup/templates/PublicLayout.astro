---
/**
 * Public pages: static header and footer (WA1) around one header island. That island hosts the
 * page's single Toaster (WA3) and survives ClientRouter navigations (WA4), so feature islands on
 * public pages never pass `withToaster`. SiteHeader renders it through a named `actions` slot.
 */
import Auth from '@/app/features/auth/Auth'
import SiteFooter from '@/app/features/landing/components/layout/SiteFooter.astro'
import SiteHeader from '@/app/features/landing/components/layout/SiteHeader.astro'
import { DEFAULT_LOCALE, getT } from '@/app/i18n'
import BaseLayout from './BaseLayout.astro'
import type { Props as BaseLayoutProps } from './BaseLayout.astro'

type Props = BaseLayoutProps

const { locale = DEFAULT_LOCALE, ...seo } = Astro.props
const t = getT(locale)
---

<BaseLayout locale={locale} {...seo}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-field focus:bg-surface focus:px-4 focus:py-2 focus:text-fg"
  >
    {t('a11y.skipToContent')}
  </a>
  <SiteHeader locale={locale}>
    <Auth slot="actions" client:idle transition:persist="auth" locale={locale} withToaster />
  </SiteHeader>
  <main id="main" class="flex-1">
    <slot />
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
